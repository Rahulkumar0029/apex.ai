# =============================================================================
# Apex.ai — Environment Variables
# Copy this file to server/.env and fill in all required values.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=4000                     # HTTP server port
CLIENT_URL=http://localhost:5173  # Frontend origin (used for CORS and OAuth redirects)

# ─── Database (Required) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/apex_ai_db

# ─── JWT (Required) ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=d5c1083fa9163db2cf5ca95215f98da90b883501d79c41c84d0129eccd7d131f
JWT_REFRESH_SECRET=8e170d6f3efc8c6ff76afd282f6bda3f8ce58d89fc7ce7ddeb8a697192a45457
JWT_ACCESS_EXPIRES_IN=24m     # Access token lifespan (e.g. 15m, 1h)
JWT_REFRESH_EXPIRES_IN=30d     # Refresh token lifespan (e.g. 7d, 30d)

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=             # From Google Cloud Console → OAuth 2.0 Client IDs
GOOGLE_CLIENT_SECRET=         # From Google Cloud Console → OAuth 2.0 Client IDs
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ─── AI Provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini            # gemini | openai — selects the active AI adapter
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Speech Provider ─────────────────────────────────────────────────────────
SPEECH_PROVIDER=assemblyai    # assemblyai | deepgram — selects the active STT/TTS adapter
ASSEMBLYAI_API_KEY=           # AssemblyAI API key (required when SPEECH_PROVIDER=assemblyai)
DEEPGRAM_API_KEY=             # Deepgram API key (required when SPEECH_PROVIDER=deepgram)

# ─── Cloudinary (Media Storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=        # Cloudinary cloud name
CLOUDINARY_API_KEY=           # Cloudinary API key
CLOUDINARY_API_SECRET=        # Cloudinary API secret

# ─── Email / SMTP (Nodemailer) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com      # SMTP server host
SMTP_PORT=587                 # SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_USER=                    # SMTP username / email address
SMTP_PASS=                    # SMTP password or app-specific password
EMAIL_FROM=noreply@apex.ai    # "From" address shown in outbound emails

# ─── Payment Provider ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER_SECRET=      # Secret key for initiating payment sessions
PAYMENT_WEBHOOK_SECRET=       # Webhook signing secret for verifying webhook payloads

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000    # Rolling window in milliseconds (default: 60 seconds)
RATE_LIMIT_MAX_REQUESTS=100   # Max requests per IP per window on auth endpoints


